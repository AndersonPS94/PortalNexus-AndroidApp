<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/radius_dialog"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/grid_32">

        <ImageView
            android:id="@+id/dialogIcon"
            android:layout_width="@dimen/icon_extra_large"
            android:layout_height="@dimen/icon_extra_large"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="@color/primary"
            android:contentDescription="@string/dialog_icon" />

        <TextView
            android:id="@+id/dialogTitle"
            style="@style/TextAppearance.PortalNexus.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/grid_24"
            android:gravity="center" />

        <TextView
            android:id="@+id/dialogMessage"
            style="@style/TextAppearance.PortalNexus.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/grid_8"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/grid_32"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cancel_label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirm"
                style="@style/Widget.PortalNexus.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/grid_8"
                android:layout_weight="1"
                android:text="@string/confirm_label" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
